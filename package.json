{
  "name": "web-ranking-reports",
  "private": true,
  "description": "Repo root — Nuxt app lives in apps/web. From here run: npm run install:web (once), then npm run dev or npm run dev:stack.",
  "scripts": {
    "install:web": "npm install --prefix apps/web",
    "dev": "npm --prefix apps/web run dev",
    "dev:stack": "npm --prefix apps/web run dev:stack",
    "build": "npm --prefix apps/web run build",
    "start": "npm --prefix apps/web run start",
    "fix-dev": "npm --prefix apps/web run fix-dev",
    "preview": "npm --prefix apps/web run preview"
  }
}
