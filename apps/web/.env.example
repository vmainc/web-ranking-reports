# Copy to .env for local development.
# PocketBase must be reachable at this URL from the browser (e.g. same machine or tunnel).
#
# Optional: Nuxt DevTools (Shift+Option+D). Default off to reduce browser console noise.
# NUXT_DEVTOOLS=1

NUXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090
APP_URL=http://localhost:3000

# Server-only (for Google OAuth and admin). Not sent to the client.
PB_URL=http://127.0.0.1:8090
# Use PB_ADMIN_* or POCKETBASE_ADMIN_* (PocketBase admin UI login, not app users)
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
STATE_SIGNING_SECRET=change-me-to-a-long-random-string
# Optional: separate secret for team-invite password links (defaults to STATE_SIGNING_SECRET)
# INVITE_PASSWORD_TOKEN_SECRET=
ADMIN_EMAILS=you@example.com

# --- Transactional email (team + client invites, sent by Nuxt, not PocketBase) ---
# PocketBase’s Admin API hides the SMTP password (******), so invites fail unless you set the
# same mailbox here. Copy host/port/username/password from PocketBase → Settings → Mailer.
# SMTP_USER=you@yourdomain.com
# SMTP_PASSWORD=your-mailbox-password-or-app-password
# Optional on VPS: force relay from env only (avoids PB API quirks)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false

# --- Agency report email via Google Gmail API (Agency → Email Sending) ---
# Create an OAuth client in Google Cloud Console (Web application). Enable Gmail API.
# Authorized redirect URI must match GOOGLE_OAUTH_REDIRECT_URI exactly, e.g.:
#   http://localhost:3000/api/agency/email-sending/google/callback
#   https://webrankingreports.com/api/agency/email-sending/google/callback
# Scopes used: openid, email, https://www.googleapis.com/auth/gmail.send
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/agency/email-sending/google/callback
# 32+ character secret (or 64-char hex) used to encrypt OAuth tokens at rest — never commit a real value.
# EMAIL_CREDENTIALS_ENCRYPTION_KEY=change-me-to-a-long-random-secret-at-least-32-chars

# --- Agency Meta / Facebook Login for Business (Agency → Integrations) ---
# Create a Meta app → Facebook Login for Business. Do not request Instagram or Ads permissions yet.
# Valid OAuth redirect URI must match META_OAUTH_REDIRECT_URI exactly:
#   http://localhost:3000/api/agency/integrations/meta/callback
#   https://webrankingreports.com/api/agency/integrations/meta/callback
# Scopes: pages_show_list, pages_read_engagement, read_insights
# Graph API version defaults to v25.0. Tokens are encrypted with EMAIL_CREDENTIALS_ENCRYPTION_KEY.
# META_APP_ID=
# META_APP_SECRET=
# META_OAUTH_REDIRECT_URI=http://localhost:3000/api/agency/integrations/meta/callback
# Optional Facebook Login for Business configuration id (when set, dialog uses config_id instead of scope)
# META_LOGIN_CONFIG_ID=
# META_GRAPH_API_VERSION=v25.0
# Daily due-only Facebook Insights sync (Nuxt server)
# SOCIAL_FACEBOOK_CRON_ENABLED=true
# SOCIAL_FACEBOOK_CRON_TZ=America/Chicago
# SOCIAL_FACEBOOK_CRON_EXPRESSION=0 6 * * *

# Optional: PageSpeed Insights API key for Lighthouse (recommended for production quota)
# PAGESPEED_API_KEY=

# Optional: Claude (Agency Planner, audits, research). Overrides PocketBase app_settings when set.
# CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5

# Stripe (per-site subscription; server secrets never exposed to the browser)
# Optional mode selector when using Admin > Integrations stored keys: test|live
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (price_...), NOT Product ids (prod_...). Dashboard → Product catalog → product → Pricing → Price API id.
# STRIPE_PRICE_ID=price_...
# Stripe Price IDs (price_...), NOT Product ids (prod_...). Dashboard → Product catalog → product → Pricing.
# STRIPE_PRICE_STARTER=price_...
# STRIPE_PRICE_GROWTH=price_...
# STRIPE_PRICE_AGENCY=price_...
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...

# Optional: Cloudflare Turnstile for public lead/contact forms (required only when both are set)
# TURNSTILE_SECRET_KEY=
# NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# Optional: weekly SERP refresh in the Nuxt server (same vars as infra/.env in Docker)
# RANK_TRACKING_WEEKLY_CRON_ENABLED=true
# Rank tracking: Tuesday + Friday 06:00 America/Chicago (override as needed)
# RANK_TRACKING_WEEKLY_CRON_ENABLED=true
# RANK_TRACKING_CRON_TZ=America/Chicago
# RANK_TRACKING_CRON_EXPRESSION=0 6 * * 2,5

# Optional: weekly Lighthouse for all sites (Friday midnight in LIGHTHOUSE_CRON_TZ)
# LIGHTHOUSE_WEEKLY_CRON_ENABLED=true
# LIGHTHOUSE_CRON_TZ=America/Chicago
# LIGHTHOUSE_CRON_EXPRESSION=0 0 * * 5
# LIGHTHOUSE_WEEKLY_STRATEGIES=mobile,desktop

# Optional: weekly DataForSEO backlink refresh + one-time bootstrap on server start (Docker: see infra/.env)
# BACKLINKS_WEEKLY_CRON_ENABLED=true
# BACKLINKS_CRON_TZ=America/Chicago
# BACKLINKS_CRON_EXPRESSION=0 0 * * 5
# BACKLINKS_BOOTSTRAP_ON_START=true
