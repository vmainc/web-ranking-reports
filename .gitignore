# Dependencies
node_modules/
**/node_modules/

# Nuxt / frontend build output
apps/web/.nuxt/
apps/web/.output/
apps/web/dist/
.nuxt/
.output/
dist/

# Environment files (never commit secrets)
.env
.env.*
!.env.example
!**/.env.example
apps/web/.env
apps/web/.env.*
!apps/web/.env.example
infra/.env
infra/.env.*
!infra/.env.example

# PocketBase runtime data and binaries
apps/pb/pb_data/
apps/pb/storage/*
!apps/pb/storage/.gitkeep
apps/pb/pocketbase
apps/pb/pocketbase.zip
apps/pb/*.db
apps/pb/*.db-*

# OS / editor / archives
.DS_Store
**/.DS_Store
__MACOSX/
**/__MACOSX/
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker local overrides (keep examples tracked)
infra/docker-compose.override.yml
