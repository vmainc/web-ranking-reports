# Copy to infra/.env on the VPS and fill in real values. Used by docker-compose.
# The web service loads optional repo-root `.env` first, then this file — duplicate keys use the value from infra/.env.

# Base domain — Caddy serves the Nuxt app (marketing homepage at /) on the apex host:
#   https://WEBRANKINGREPORTS_DOMAIN
# www is redirected to apex. PocketBase: https://POCKETBASE_SUBDOMAIN.WEBRANKINGREPORTS_DOMAIN
# Point DNS A/AAAA for @ and www to your VPS IP.
# WEBRANKINGREPORTS_DOMAIN=webrankingreports.com
# POCKETBASE_SUBDOMAIN=pb

# Nuxt must call PocketBase at the public URL (browser)
NUXT_PUBLIC_POCKETBASE_URL=https://pb.webrankingreports.com
# Use the apex URL (no www) so links and OAuth redirects match the canonical site
APP_URL=https://webrankingreports.com

# Server-only: PocketBase admin (same login as https://pb.webrankingreports.com/_/)
# Use http://pb:8090 when running in Docker so the web container reaches PB on the internal network.
# From the VPS host or your laptop, `node apps/web/scripts/add-users-default-google-json.mjs` uses
# NUXT_PUBLIC_POCKETBASE_URL when PB_URL is http://pb… (internal hostname does not resolve off-Docker).
# Schema migrations: docker-compose mounts ../apps/pb/pb_migrations → /pb_data/pb_migrations so new fields (e.g. users.default_google_json) apply on pb restart.
PB_URL=http://pb:8090
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=

# Required for Google OAuth and for team/client invite “set password” links in the web app. Generate with: openssl rand -hex 32
STATE_SIGNING_SECRET=
# Optional; team-invite password links default to STATE_SIGNING_SECRET
# INVITE_PASSWORD_TOKEN_SECRET=

# Comma-separated emails that can access Admin → Integrations (e.g. admin@vma.agency)
ADMIN_EMAILS=admin@vma.agency

# Required for team/client invites and other mail from the Nuxt app. PocketBase’s Admin API hides
# the mailer password (******), so the web container cannot reuse PB settings without these.
# Use the same mailbox user + password as PocketBase → Settings → Mailer.
# Must be literal lines (not commented) — names are exactly SMTP_USER and SMTP_PASSWORD:
SMTP_USER=
SMTP_PASSWORD=
# Optional: force host/port from env (recommended on some VPS setups)
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Optional: PageSpeed Insights API key for Lighthouse (recommended for production quota)
# PAGESPEED_API_KEY=

# Optional: Claude API for Agency Planner + site audit / research (overrides Admin → Integrations store)
# CLAUDE_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-haiku-4-5
# CLAUDE_API_URL=https://api.anthropic.com/v1/messages

# Stripe (server): Checkout + Customer Portal + webhooks. Use price_… IDs (not prod_…).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_ID=price_...
# Live WRR Starter, Growth, and Agency price IDs.
STRIPE_PRICE_STARTER=price_1TWm1LLWo32K88xv8drSV0OT
STRIPE_PRICE_GROWTH=price_1TWm2PLWo32K88xvpEf1egyW
STRIPE_PRICE_AGENCY=price_1TWm2lLWo32K88xvNPpI3p0m
# NUXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
# Webhook URL (Nuxt): https://YOUR_DOMAIN/api/stripe/webhook

# Set to false to hide WooCommerce integration and reports everywhere (default: true)
# NUXT_PUBLIC_WOOCOMMERCE_ENABLED=false

# Automated rank tracking (Nuxt server): refresh all sites’ keywords on a schedule.
# docker-compose defaults: enabled, America/Chicago, Friday 00:00. Set to false to disable.
# RANK_TRACKING_WEEKLY_CRON_ENABLED=true
# RANK_TRACKING_CRON_TZ=America/Chicago
# RANK_TRACKING_CRON_EXPRESSION=0 0 * * 5

# Weekly Lighthouse (PageSpeed) for all sites with a domain (mobile + desktop by default).
# Requires PAGESPEED_API_KEY in env_file for reliable production quota.
# LIGHTHOUSE_WEEKLY_CRON_ENABLED=true
# LIGHTHOUSE_CRON_TZ=America/Chicago
# LIGHTHOUSE_CRON_EXPRESSION=0 0 * * 5
# LIGHTHOUSE_WEEKLY_STRATEGIES=mobile,desktop

# Weekly DataForSEO backlink profile for all sites with a domain (same credentials as rank tracking).
# docker-compose defaults: enabled, America/Chicago, Friday 00:00.
# BACKLINKS_WEEKLY_CRON_ENABLED=true
# BACKLINKS_CRON_TZ=America/Chicago
# BACKLINKS_CRON_EXPRESSION=0 0 * * 5
# On first deploy, fetches all existing sites once (~60s after web starts; 3s between sites).
# BACKLINKS_BOOTSTRAP_ON_START=true
# BACKLINKS_FORCE_BOOTSTRAP=true
# BACKLINKS_SITE_DELAY_MS=3000

# Automated report_schedules worker (Nuxt server): polls PocketBase every ~7 minutes in UTC by default.
# REPORT_SCHEDULES_CRON_ENABLED=true
# REPORT_SCHEDULES_CRON_TZ=UTC
# REPORT_SCHEDULES_CRON_EXPRESSION=*/7 * * * *

# Email campaigns worker (Nuxt server): sends scheduled / in-progress campaigns in batches every few minutes.
# EMAIL_CAMPAIGNS_CRON_ENABLED=true
# EMAIL_CAMPAIGNS_CRON_TZ=UTC
# EMAIL_CAMPAIGNS_CRON_EXPRESSION=*/3 * * * *
# EMAIL_CAMPAIGNS_BATCH_SIZE=25
