# Web Ranking Reports — Caddy reverse proxy
# Env (set in docker-compose): WEBRANKINGREPORTS_DOMAIN, POCKETBASE_SUBDOMAIN
# - Apex https://WEBRANKINGREPORTS_DOMAIN → Nuxt (marketing homepage at /, app routes under /dashboard, etc.)
# - www → permanent redirect to apex
# - https://POCKETBASE_SUBDOMAIN.WEBRANKINGREPORTS_DOMAIN → PocketBase
#
# Local IP-only testing (before DNS): see Caddyfile.ip-test.example — do NOT enable in production.

{
  email admin@webrankingreports.com
}

# Shared security headers for the Nuxt app (practical CSP — allows Stripe, Google OAuth, Turnstile, PB API)
(web_security) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
    X-Frame-Options "SAMEORIGIN"
    Content-Security-Policy "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://js.stripe.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://{$POCKETBASE_SUBDOMAIN:pb}.{$WEBRANKINGREPORTS_DOMAIN:webrankingreports.com} wss://{$POCKETBASE_SUBDOMAIN:pb}.{$WEBRANKINGREPORTS_DOMAIN:webrankingreports.com} https://api.stripe.com https://accounts.google.com https://oauth2.googleapis.com https://www.googleapis.com https://challenges.cloudflare.com; frame-src 'self' https://js.stripe.com https://hooks.stripe.com https://accounts.google.com https://challenges.cloudflare.com; frame-ancestors 'self'; form-action 'self' https://accounts.google.com"
    -Server
  }
}

# Lighter headers for PocketBase admin (avoid CSP that breaks PB UI)
(pb_security) {
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    Referrer-Policy "strict-origin-when-cross-origin"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    X-Frame-Options "SAMEORIGIN"
    -Server
  }
}

# Nuxt app — apex (top-level) domain = public homepage + authenticated app
{$WEBRANKINGREPORTS_DOMAIN:webrankingreports.com} {
  import web_security
  reverse_proxy web:3000 {
    transport http {
      versions 1.1
      response_header_timeout 300s
    }
  }
}

# Send www traffic to apex so the homepage and app live on one canonical host
www.{$WEBRANKINGREPORTS_DOMAIN:webrankingreports.com} {
  import web_security
  redir https://{$WEBRANKINGREPORTS_DOMAIN:webrankingreports.com}{uri} permanent
}

# PocketBase API + Admin
{$POCKETBASE_SUBDOMAIN:pb}.{$WEBRANKINGREPORTS_DOMAIN:webrankingreports.com} {
  import pb_security
  reverse_proxy pb:8090 {
    transport http {
      versions 1.1
    }
  }
}
